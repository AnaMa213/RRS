diff --git a/Assets/RoadRage/Features/Vehicles/Traffic/Routing/RoutePlan.cs b/Assets/RoadRage/Features/Vehicles/Traffic/Routing/RoutePlan.cs
new file mode 100644
index 0000000..301259f
