        private static TrafficSettingsDef BuildDef(int defaultTargetPopulation, int defaultLitterThrowers, int minLitterThrowers, int maxLitterThrowers)
        {
            var def = ScriptableObject.CreateInstance<TrafficSettingsDef>();
